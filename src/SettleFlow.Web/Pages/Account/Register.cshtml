@page
@model SettleFlow.Web.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Create a free account"; }
<div class="form-narrow card">
    <h1>Create your free account</h1>
    <p class="muted">No card and no time limit. Start with sample files or use your own.</p>
    <div asp-validation-summary="All" class="alert alert-bad" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>
    <form method="post">
        <div class="field"><label asp-for="Input.Organization">Business or team name</label><input asp-for="Input.Organization" autocomplete="organization" /><span asp-validation-for="Input.Organization" class="field-error"></span></div>
        <div class="field"><label asp-for="Input.Email">Work email</label><input asp-for="Input.Email" autocomplete="email" /><span asp-validation-for="Input.Email" class="field-error"></span></div>
        <div class="field"><label asp-for="Input.Password">Password</label><input asp-for="Input.Password" autocomplete="new-password" aria-describedby="password-help" /><div id="password-help" class="hint">At least 10 characters, with upper- and lower-case letters and a digit.</div><span asp-validation-for="Input.Password" class="field-error"></span></div>
        <button class="btn" type="submit">Create free account</button>
        <p class="consent">By creating an account you agree to the <a href="/terms" target="_blank">Terms of service</a> and <a href="/privacy" target="_blank">Privacy policy</a>.</p>
        <span class="muted small" style="margin-left:10px">Have one? <a asp-page="Login">Sign in</a></span>
    </form>
</div>
