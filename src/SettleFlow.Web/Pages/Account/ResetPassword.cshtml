@page
@model SettleFlow.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Choose a new password"; }
<div class="form-narrow card">
    <h1>Choose a new password</h1>
    <div asp-validation-summary="All" class="alert alert-bad" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>
    <form method="post">
        <input type="hidden" asp-for="UserId" /><input type="hidden" asp-for="Token" />
        <div class="field"><label asp-for="Password">New password</label><input asp-for="Password" type="password" autocomplete="new-password" required />
            <div class="hint">At least 10 characters, with upper- and lower-case letters and a digit.</div></div>
        <button class="btn" type="submit">Save password</button>
    </form>
</div>
