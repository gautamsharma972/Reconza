@page "/solutions/excel-reconciliation-software"
@{
    var faq = new (string Q, string A)[]
    {
        ("How is this different from Excel's own tools?", "Excel formulas work well when two clean files always have the same layout. Reconza also handles changing headers, IDs written in different ways, several related files and a repeatable review process without rebuilding formulas."),
        ("Do I need to replace Excel or connect my accounting system?", "No. Upload the Excel or CSV exports you already use. Reconza checks them and gives the result back as Excel, so you can keep your existing systems and process."),
        ("Can I create my own recurring check?", "Yes. Choose the columns that identify a record, the amounts to compare and which files add to or subtract from the result. Save that setup and reuse it next week or month."),
    };
}
@section Head {
    @JsonLd.Script(JsonLd.Breadcrumbs(AppUrls, ("Home", "/"), ("Excel reconciliation software", "/solutions/excel-reconciliation-software")))
    @JsonLd.Script(JsonLd.Faq(faq))
}
<section class="page-hero">
    <span class="badge badge-brand">For small finance &amp; operations teams</span>
    <h1>Check recurring spreadsheets without rebuilding formulas</h1>
    <p>Compare supplier statements, customer payments, branch reports and other business files. Reconza finds missing records, duplicates and incorrect amounts, then produces a clear Excel report.</p>
    <div class="row" style="justify-content:center"><a class="btn btn-lg" href="/tools/compare-excel-files">Compare two files free</a><a class="btn btn-lg btn-secondary" href="/Account/Register">Create free account</a></div>
    <p class="hero-note">No card needed · Use your existing Excel or CSV exports · Your original files stay unchanged</p>
</section>

<section class="section solution-flow">
    <div class="section-heading"><span class="eyebrow">A simpler process</span><h2 class="section-title">Use the reports you already receive</h2></div>
    <div class="grid grid-3 steps">
        <div class="card step"><h3>Add the files</h3><p>Upload spreadsheets from your accounting system, vendor, customer, branch or marketplace.</p></div>
        <div class="card step"><h3>Confirm what matches</h3><p>Tell Reconza which columns contain the same ID and amount. It remembers the setup.</p></div>
        <div class="card step"><h3>Review the differences</h3><p>See missing, repeated and incorrect records with the source row behind every result.</p></div>
    </div>
</section>

<section class="section">
    <div class="section-heading"><span class="eyebrow">Common checks</span><h2 class="section-title">Useful anywhere two business reports should agree</h2></div>
    <div class="grid grid-2 feature-grid">
        <div class="feature"><h3>Supplier statement vs purchase register</h3><p>Find invoices missing from either side and amounts that do not agree.</p></div>
        <div class="feature"><h3>Customer payments vs invoices</h3><p>See which invoices were paid, left unpaid or paid at the wrong amount.</p></div>
        <div class="feature"><h3>Distributor reports vs dispatch records</h3><p>Reuse one check even when every distributor names its columns differently.</p></div>
        <div class="feature"><h3>Branch or warehouse reports</h3><p>Compare recurring submissions and identify missing or duplicate entries.</p></div>
    </div>
</section>

<section class="section trust-panel grid grid-2">
    <div><span class="eyebrow">Made for imperfect exports</span><h2>The files do not need to look identical</h2><p>Reconza can recognise IDs such as <code>INV-0042</code>, <code>inv 42</code> and <code>INV0042</code> as the same record. It also handles common date and currency formats, title rows and blank rows.</p></div>
    <ul class="checks"><li>No formulas or scripts to maintain</li><li>Several related files in one saved check</li><li>Repeatable results from fixed rules</li><li>Downloadable Excel report and activity history</li></ul>
</section>
<section class="section faq">
    <h2 class="section-title">Questions</h2>
    @foreach (var (q, a) in faq) { <details><summary>@q</summary><p>@a</p></details> }
</section>
<partial name="_Cta" model="@((string?)null)" />
