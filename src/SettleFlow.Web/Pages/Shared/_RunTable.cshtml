@model List<SettleFlow.Web.Data.Run>
@if (Model.Count == 0)
{
    <div class="empty"><div class="empty-icon">⇄</div><strong>No checks yet</strong><div class="muted small">Your completed and in-progress file checks will appear here.</div></div>
}
else
{
    <div class="table-wrap">
    <table class="clickable responsive-table run-history-table">
        <thead><tr><th>Check</th><th>Saved setup</th><th>When</th><th class="num">Net</th><th class="num">Issues</th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            var url = Url.Page("/Runs/Details", new { id = r.Id });
            <tr data-href="@url">
                <td data-label="Check"><a href="@url"><strong>@r.Label</strong></a>
                    @switch (r.Status)
                    {
                        case RunStatus.Queued: <span class="badge">Queued</span> break;
                        case RunStatus.Processing: <span class="badge badge-brand"><span class="dot-pulse"></span> Processing</span> break;
                        case RunStatus.Failed: <span class="badge badge-bad">Failed</span> break;
                    }
                </td>
                <td data-label="Saved check" class="muted">@r.WorkflowName</td>
                <td data-label="When" class="muted small" title="@r.CreatedAt.ToString("u")">@r.CreatedAt.ToString("dd MMM, HH:mm")</td>
                <td data-label="Net" class="num">@(r.Status == RunStatus.Completed ? r.NetTotal.ToString("N2") : "—")</td>
                <td data-label="Issues" class="num">@if (r.Status != RunStatus.Completed) { <span class="muted">—</span> } else if (r.ExceptionCount > 0) { <span class="badge badge-warn">@r.ExceptionCount</span> } else { <span class="badge badge-ok">0</span> }</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
