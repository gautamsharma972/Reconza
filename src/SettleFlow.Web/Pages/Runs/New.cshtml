@page "{workflowId:guid}"
@model SettleFlow.Web.Pages.Runs.NewModel
@using System.Text.Json
@{
    ViewData["Title"] = "New check";
    string RoleLabel(SourceRole role) => role switch
    {
        SourceRole.Primary => "Main list",
        SourceRole.Deduction => "Subtracts",
        SourceRole.Addition => "Adds",
        _ => "Check only"
    };
    string RoleHelp(SourceRole role) => role switch
    {
        SourceRole.Primary => "Other files will be checked against this one.",
        SourceRole.Deduction => "Amounts in this file reduce the result.",
        SourceRole.Addition => "Amounts in this file increase the result.",
        _ => "Used to find differences without changing the result."
    };
}
<div class="page-head">
    <div>
        <div class="crumbs"><a asp-page="/Workflows/Index">Saved checks</a> / <a asp-page="/Workflows/Edit" asp-route-id="@Model.Workflow.Id">@Model.Workflow.Name</a></div>
        <h1>Check new files</h1>
        <div class="muted">Add this period's @Model.Def.Sources.Count files, confirm each one is in the right place, then start the check.</div>
    </div>
</div>

@if (Model.SetupIssues.Count > 0)
{
    <div class="alert alert-warn"><strong>This saved check isn't ready yet.</strong> <a asp-page="/Workflows/Edit" asp-route-id="@Model.Workflow.Id">Finish setup</a>
        <ul>@foreach (var e in Model.SetupIssues) { <li>@e</li> }</ul></div>
}
@if (Model.Errors.Count > 0)
{
    <div class="alert alert-bad"><strong>We couldn't start this check:</strong><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
}

<form method="post" enctype="multipart/form-data" asp-route-workflowId="@Model.Workflow.Id" data-busy-form id="run-form" data-max-file-bytes="@(Model.Limits.MaxFileMb * 1024L * 1024L)">
    <div class="upload-steps" aria-label="How to check files">
        <span><b>1</b> Add all files</span><span><b>2</b> Confirm where they belong</span><span><b>3</b> Start the check</span>
    </div>
    <label class="dropzone" data-multi-drop aria-describedby="upload-help upload-error">
        <input type="file" multiple accept=".xlsx,.xls,.csv" data-multi-input />
        <span class="dz-icon" aria-hidden="true">⤒</span>
        <span><strong>Drop all @Model.Def.Sources.Count files here</strong> or choose them from your device</span>
        <span class="muted small" id="upload-help">Reconza will suggest where each file belongs based on its name. Accepts .xlsx, .xls and .csv, up to @Model.Limits.MaxFileMb MB per file.</span>
    </label>
    <div class="alert alert-bad upload-error" id="upload-error" data-upload-error role="alert" hidden></div>
    <noscript><div class="alert alert-info">Choose one file in each box below. JavaScript is only needed for automatic file placement.</div></noscript>

    <div class="slots">
        @for (var i = 0; i < Model.Def.Sources.Count; i++)
        {
            var s = Model.Def.Sources[i];
            var hints = new List<string> { s.Name };
            if (Model.LastFileNames.TryGetValue(s.Name, out var last)) hints.Add(System.IO.Path.GetFileNameWithoutExtension(last));
            hints.AddRange(s.ColumnMap.Values);
            <div class="slot" data-slot data-hints="@JsonSerializer.Serialize(hints)">
                <div class="slot-head">
                    <div><strong>@s.Name</strong><div class="muted small">@RoleHelp(s.Role)</div></div>
                    <span class="badge role-badge role-@s.Role">@RoleLabel(s.Role)</span>
                </div>
                <label class="slot-drop">
                    <input type="file" name="file_@i" accept=".xlsx,.xls,.csv" data-slot-input />
                    <span class="slot-empty">Drop or choose file@(last is not null ? $" · last time: {last}" : "")</span>
                    <span class="slot-file" hidden><span class="slot-check">✓</span> <span data-name></span> <span class="muted small" data-size></span></span>
                </label>
                <button type="button" class="btn-link small" data-clear hidden>Remove</button>
            </div>
        }
    </div>

    <div class="card row" style="margin-top:16px">
        <div class="field" style="flex:1; min-width:240px; margin:0"><label asp-for="Label">Name for this check</label><input asp-for="Label" /></div>
        <div class="spacer"></div>
        <div class="muted small" data-slot-status role="status" aria-live="polite"></div>
        <button class="btn btn-lg" type="submit" data-busy="Uploading and checking…" data-submit-run data-blocked="@(Model.SetupIssues.Count > 0 ? "true" : null)">Check files →</button>
    </div>
</form>

@if (Model.SamplesAvailable)
{
    <form method="post" asp-page-handler="Sample" asp-route-workflowId="@Model.Workflow.Id" class="card demo-card" data-busy-form>
        <div>
            <h3>No files handy? Try the demo week.</h3>
            <p class="muted small" style="margin:0">Deliberately messy files: title rows, IDs like <code>T-1001</code> vs <code>t1001</code>, mixed date formats, duplicates, a short-paid trip and an orphan fuel fill.
                <a asp-page="/Samples" asp-route-file="trips.xlsx">Download them</a> to see.</p>
        </div>
        <button class="btn btn-secondary" type="submit" data-busy="Starting demo…">Check the demo files</button>
    </form>
}
