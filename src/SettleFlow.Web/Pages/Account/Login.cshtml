@page
@model SettleFlow.Web.Pages.Account.LoginModel
@{ ViewData["Title"] = "Sign in"; }
<div class="form-narrow card">
    <h1>Sign in</h1>
    @if (Model.Error is not null) { <div class="alert alert-bad">@Model.Error</div> }
    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="field"><label asp-for="Email">Email</label><input asp-for="Email" autocomplete="username" /></div>
        <div class="field"><label asp-for="Password">Password</label><input asp-for="Password" type="password" autocomplete="current-password" /></div>
        <button class="btn" type="submit">Sign in</button>
        <a class="small" asp-page="ForgotPassword" style="margin-left:10px">Forgot password?</a>
        <a class="small" asp-page="ResendConfirmation" style="margin-left:10px">Resend confirmation email</a>
        <span class="muted small" style="margin-left:10px">New here? <a asp-page="Register">Create a free account</a></span>
    </form>
</div>
