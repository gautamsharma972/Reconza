<?xml version="1.0" encoding="utf-8"?>
<!-- Reconza for IIS / Plesk (self-contained build: runs Reconza.Web.exe directly).
     Deliberately minimal: shared hosts often lock request-filtering/header sections, and older IIS 10 builds
     reject attributes such as removeServerHeader, which makes IIS return an empty 500 before the app starts.
     To diagnose start-up problems set stdoutLogEnabled="true" (and create a writable "logs" folder). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\Reconza.Web.exe" arguments="" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
