@page
@model SettleFlow.Web.Pages.Audit.IndexModel
@{ ViewData["Title"] = "Activity"; }
<div class="page-head"><div><h1>Activity</h1><div class="muted">A permanent record of who changed, checked, reviewed or downloaded what.</div></div>
    <input type="search" data-filter="#audit" aria-label="Filter activity" placeholder="Filter activity…" style="max-width:260px" /></div>
<div class="card card-tight">
    <div class="table-wrap">
    <table id="audit">
        <thead><tr><th>When (UTC)</th><th>User</th><th>Action</th><th>Details</th></tr></thead>
        <tbody>
        @foreach (var e in Model.Events)
        {
            <tr>
                <td class="small mono" style="white-space:nowrap">@e.At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td class="small">@e.User</td>
                <td><span class="badge">@e.Action</span></td>
                <td class="small">@e.Details
                    @if (e.EntityId is not null && (e.Action.StartsWith("run") || e.Action.StartsWith("exception") || e.Action.StartsWith("report")))
                    { <a asp-page="/Runs/Details" asp-route-id="@e.EntityId">view check</a> }</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
