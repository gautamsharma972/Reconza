@page "{id:guid}"
@model SettleFlow.Web.Pages.Workflows.SourceModel
@using System.Text.Json
@{
    ViewData["Title"] = $"{Model.Source.Name} — mapping";
    var isPrimary = Model.Role == SourceRole.Primary;
    var numberFields = Model.Def.Fields.Where(f => f.Type == FieldType.Number).ToList();
    string ConfClass(double c) => c >= 0.85 ? "badge-ok" : c >= 0.6 ? "badge-warn" : "badge-bad";
    string RoleLabel(SourceRole role) => role switch
    {
        SourceRole.Primary => "Main list",
        SourceRole.Deduction => "Subtracts from result",
        SourceRole.Addition => "Adds to result",
        _ => "Used for checking"
    };
}
<div class="page-head">
    <div>
        <div class="crumbs"><a asp-page="Index">Saved checks</a> / <a asp-page="Edit" asp-route-id="@Model.Workflow.Id">@Model.Workflow.Name</a></div>
        <h1>@Model.Source.Name <span class="badge role-badge role-@Model.Role">@RoleLabel(Model.Role)</span></h1>
        <div class="muted">Tell Reconza how to read this file. You only do this once—the column choices are reused every time.</div>
    </div>
</div>

<form method="post" enctype="multipart/form-data" asp-route-id="@Model.Workflow.Id" data-busy-form>
    <input type="hidden" asp-for="SourceName" />
    <input type="hidden" asp-for="HeadersJson" />

    <section class="card step-card">
        <div class="step-num">1</div>
        <div class="step-body">
            <h2>Load a sample file <span class="muted small">recommended</span></h2>
            <p class="muted small">Use a recent example of this file. Reconza will read its column names, show a preview and suggest where each value belongs. The sample isn't stored.</p>
            <label class="dropzone dropzone-sm" data-dropzone>
                <input type="file" name="SampleFile" accept=".xlsx,.xls,.csv" data-autosubmit="Analyze" />
                <span class="dz-icon" aria-hidden="true">⤒</span>
                <span><strong>Drop a file here</strong> or click to browse <span class="muted small">· .xlsx, .xls, .csv</span></span>
                <span class="dz-file muted small"></span>
            </label>
            <div class="row" style="margin-top:10px">
                <input asp-for="SheetName" placeholder="Worksheet (blank = first)" style="max-width:240px" list="sheets" />
                <datalist id="sheets">@foreach (var s in Model.SheetNames) { <option value="@s"></option> }</datalist>
                <button class="btn btn-secondary" type="submit" asp-page-handler="Analyze" data-busy="Reading file…">Read sample file</button>
            </div>
            @if (Model.AnalyzeMessage is not null)
            {
                <div class="alert @(Model.AnalyzeFailed ? "alert-bad" : "alert-info")" style="margin:14px 0 0">@Model.AnalyzeMessage</div>
            }
            @if (Model.AiNotice is not null) { <div class="alert alert-warn" style="margin:10px 0 0">@Model.AiNotice</div> }
            @if (Model.Preview.Count > 0)
            {
                <details class="preview-wrap" open>
                    <summary>Preview — first @Model.Preview.Count rows</summary>
                    <div class="table-wrap">
                        <table class="preview">
                            <thead><tr>@foreach (var h in Model.Headers) { <th>@h</th> }</tr></thead>
                            <tbody>@foreach (var r in Model.Preview) { <tr>@foreach (var c in r) { <td title="@c">@c</td> }</tr> }</tbody>
                        </table>
                    </div>
                </details>
                <script type="application/json" id="preview-data">@Html.Raw(JsonSerializer.Serialize(new { headers = Model.Headers, rows = Model.Preview.Take(3) }).Replace("<", "\\u003c"))</script>
            }
        </div>
    </section>

    <section class="card step-card">
        <div class="step-num">2</div>
        <div class="step-body">
            <h2>What is this file?</h2>
            <div class="role-picker">
                @foreach (var role in Enum.GetValues<SourceRole>())
                {
                    var (title, desc) = role switch
                    {
                        SourceRole.Primary => ("Main list", "Your starting list, such as a trip register. Other files are checked against it."),
                        SourceRole.Deduction => ("Subtract from result", "For costs such as fuel advances, tolls or damages."),
                        SourceRole.Addition => ("Add to result", "For bonuses, reimbursements or other additions."),
                        _ => ("Use for checking only", "Cross-check records or amounts without changing the final total.")
                    };
                    <label class="role-option role-@role">
                        <input type="radio" name="Role" value="@role" checked="@(role == Model.Role)" />
                        <strong>@title</strong><span class="muted small">@desc</span>
                    </label>
                }
            </div>
        </div>
    </section>

    <section class="card step-card card-flush">
        <div class="step-num">3</div>
        <div class="step-body">
            <h2>Match columns to fields</h2>
            <p class="muted small">For each piece of information, choose the column that contains it. Leave it blank if this file does not have that information.</p>
            <div class="field-legend small">
                <span><strong>Needed</strong> flags an empty value</span>
                <span><strong>Find duplicates</strong> identifies repeated records</span>
                @if (!isPrimary) { <span><strong>Connect files</strong> links a row to @(Model.Primary?.Name ?? "the main list")</span> }
            </div>
            <datalist id="headers">@foreach (var h in Model.Headers) { <option value="@h"></option> }</datalist>
            <div class="table-wrap">
            <table class="map-table">
                <thead><tr><th>Information</th><th>Column in your file</th><th>Example values</th><th class="center">Needed</th><th class="center">Find duplicates</th>@if (!isPrimary) { <th class="center">Connect files</th> }</tr></thead>
                <tbody>
                @foreach (var f in Model.Def.Fields)
                {
                    var sug = Model.Suggestions.GetValueOrDefault(f.Name);
                    var mapped = Model.Map.GetValueOrDefault(f.Name);
                    <tr>
                        <td><strong>@f.Label</strong><div class="muted small">@f.Type</div></td>
                        <td style="min-width:230px">
                            <input name="Map[@f.Name]" value="@mapped" list="headers" placeholder="— not in this file —" data-map-input />
                            @if (sug?.Column is not null && sug.Column == mapped)
                            {
                                <div class="sugg" title="@sug.Reason">
                                    <span class="badge @(sug.Origin == "Rules" ? "" : "badge-ai")">@(sug.Origin == "Rules" ? "Rules" : sug.Origin == "AI" ? "✦ AI" : "✦ Rules + AI")</span>
                                    <span class="badge @ConfClass(sug.Confidence)">@((sug.Confidence * 100).ToString("0"))%</span>
                                </div>
                            }
                        </td>
                        <td class="samples muted small" data-samples></td>
                        <td class="center"><input type="checkbox" name="Required" value="@f.Name" checked="@Model.Required.Contains(f.Name)" /></td>
                        <td class="center"><input type="checkbox" name="Key" value="@f.Name" checked="@Model.Key.Contains(f.Name)" /></td>
                        @if (!isPrimary) { <td class="center">@if (Model.Primary?.ColumnMap.ContainsKey(f.Name) == true) { <input type="checkbox" name="Match" value="@f.Name" checked="@Model.Match.Contains(f.Name)" /> } else { <span class="muted small" title="Not mapped on the primary source">—</span> }</td> }
                    </tr>
                }
                </tbody>
            </table>
            </div>
        </div>
    </section>

    <section class="card step-card">
        <div class="step-num">4</div>
        <div class="step-body">
            <h2>Choose the amount and date</h2>
            <p class="muted small">Tell Reconza which amount affects the result. The date format helps it read dates consistently.</p>
            <div class="grid grid-2">
                <div class="field"><label asp-for="AmountField">Amount to include in totals</label>
                    <select asp-for="AmountField"><option value="">— do not total this file —</option>@foreach (var f in numberFields) { <option value="@f.Name" selected="@(f.Name == Model.AmountField)">@f.Label</option> }</select></div>
                <div class="field"><label asp-for="DateFormats">Date format in this file</label><input asp-for="DateFormats" placeholder="e.g. dd/MM/yyyy" />
                    <div class="hint">For example, <code>dd/MM/yyyy</code> reads 03/04 as 3 April.</div></div>
            </div>
            @if (!isPrimary)
            {
                <details class="advanced-panel nested-panel">
                    <summary><span><strong>Advanced checks</strong><small>Missing records, unmatched totals and amount comparisons</small></span></summary>
                    <div class="advanced-body">
                    <div class="grid grid-2">
                        <div>
                            <label class="check"><input type="checkbox" name="ExpectEveryPrimaryRow" value="true" checked="@Model.ExpectEveryPrimaryRow" /><input type="hidden" name="ExpectEveryPrimaryRow" value="false" /> Flag records from @(Model.Primary?.Name ?? "the main list") that are missing here</label>
                            <label class="check" style="margin-top:8px"><input type="checkbox" name="ExcludeUnmatchedFromTotals" value="true" checked="@Model.ExcludeUnmatchedFromTotals" /><input type="hidden" name="ExcludeUnmatchedFromTotals" value="false" /> Leave rows that cannot be connected out of totals</label>
                        </div>
                        <div>
                            <h3>Compare amounts</h3>
                            <div class="grid grid-2">
                                <div class="field"><label>Amount in this file</label><select asp-for="CompareField"><option value="">— off —</option>@foreach (var f in numberFields) { <option value="@f.Name" selected="@(f.Name == Model.CompareField)">@f.Label</option> }</select></div>
                                <div class="field"><label>Amount in @(Model.Primary?.Name ?? "main list")</label><select asp-for="PrimaryCompareField"><option value="">— off —</option>@foreach (var f in numberFields) { <option value="@f.Name" selected="@(f.Name == Model.PrimaryCompareField)">@f.Label</option> }</select></div>
                            </div>
                            <div class="field"><label asp-for="CompareTolerance">Difference allowed before flagging</label><input asp-for="CompareTolerance" type="number" step="0.01" min="0" style="max-width:160px" /></div>
                        </div>
                    </div>
                    </div>
                </details>
            }
        </div>
    </section>

    <div class="sticky-actions">
        <a class="btn btn-secondary" asp-page="Edit" asp-route-id="@Model.Workflow.Id">Cancel</a>
        <button class="btn" type="submit" asp-page-handler="Save" data-busy="Saving…">Save file setup</button>
    </div>
</form>
