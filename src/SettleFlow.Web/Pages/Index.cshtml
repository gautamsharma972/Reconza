@page
@model IndexModel
@{ ViewData["Title"] = Model.SignedIn ? "Dashboard" : null; }
@section Head {
    @if (!Model.SignedIn)
    {
        @JsonLd.Script(new Dictionary<string, object> { ["@context"] = "https://schema.org", ["@type"] = "WebSite", ["name"] = "Reconza", ["alternateName"] = "Reconza reconciliation software", ["url"] = AppUrls.Absolute("/"), ["inLanguage"] = "en-IN" })
        @JsonLd.Script(JsonLd.Software(AppUrls))
        @JsonLd.Script(JsonLd.Faq(IndexModel.Faq))
        @JsonLd.Script(new Dictionary<string, object> { ["@context"] = "https://schema.org", ["@type"] = "Organization", ["name"] = "Reconza", ["url"] = AppUrls.Absolute("/"), ["logo"] = AppUrls.Absolute("/img/apple-touch-icon.png") })
    }
}
@if (!Model.SignedIn)
{
    <section class="hero hero-split">
        <div>
            <span class="badge badge-brand">For transporters, fleets, distributors &amp; online sellers</span>
            <h1>Driver settlement &amp; reconciliation software that reads your Excel files</h1>
            <p>Upload trip sheets, fuel card statements, deduction lists and customer reports exactly as you receive them. Reconza matches them, flags every duplicate, gap and mismatch, and hands you the settlement — in minutes instead of a day.</p>
            <div class="row" style="margin-top:22px">
                <a class="btn btn-lg" asp-page="/Account/Register">Start free trial</a>
                <a class="btn btn-lg btn-secondary" href="/tools/compare-excel-files">Compare two files free</a>
            </div>
            <p class="muted small" style="margin-top:12px">No card needed · Works with .xlsx, .xls and .csv · Plans from ₹999/month</p>
        </div>
        <div class="hero-visual" aria-hidden="true">
            <div class="mock-files">
                <span>trips.xlsx</span><span>fuel.csv</span><span>deductions.xlsx</span><span>customer_report.xlsx</span>
            </div>
            <div class="mock-arrow">↓</div>
            <div class="mock-result">
                <div class="mock-row mock-head"><span>Driver</span><span>Freight</span><span>Fuel</span><span>Net</span></div>
                <div class="mock-row"><span>D001</span><span>38,930</span><span>−18,798</span><b>18,132</b></div>
                <div class="mock-row"><span>D002</span><span>41,854</span><span>−22,847</span><b>17,957</b></div>
                <div class="mock-row"><span>D003</span><span>29,351</span><span>−24,004</span><b>3,847</b></div>
                <div class="mock-flags"><span class="badge badge-warn">Short-paid T-1004: −1,250</span><span class="badge badge-brand">Duplicate trip T-1007</span><span class="badge badge-warn">Fuel fill with no trip</span></div>
            </div>
        </div>
    </section>

    <section class="section">
        <h2 class="section-title">Sound familiar?</h2>
        <div class="grid grid-3">
            <div class="card"><h3>Every file looks different</h3><p class="muted">Your TMS exports one format, the fuel card portal another, and each customer sends their own report — with different IDs for the same trip.</p></div>
            <div class="card"><h3>Settlement day eats a whole day</h3><p class="muted">VLOOKUPs break, someone pastes over a formula, and you still find a duplicate trip after the money has gone out.</p></div>
            <div class="card"><h3>Disputes with no paper trail</h3><p class="muted">When a driver or customer questions a number, it takes hours to trace it back to the row it came from.</p></div>
        </div>
    </section>

    <section id="how" class="section">
        <h2 class="section-title">How it works</h2>
        <div class="grid grid-4 steps">
            <div class="card step"><h3>Upload</h3><p class="muted small">Drop this week's files. Reconza finds the header row and recognises which file is which.</p></div>
            <div class="card step"><h3>Map once</h3><p class="muted small">Columns are matched automatically; you confirm once and the mapping is reused every week.</p></div>
            <div class="card step"><h3>Review exceptions</h3><p class="muted small">Duplicates, missing records and mismatches, each explained in plain English with a suggested fix.</p></div>
            <div class="card step"><h3>Download &amp; pay</h3><p class="muted small">Settlement workbook, per-driver statements and an audit trail of every decision.</p></div>
        </div>
    </section>

    <section class="section">
        <h2 class="section-title">Built for these workflows</h2>
        <div class="grid grid-3">
            <a class="card card-link" href="/solutions/driver-settlement-software"><h3>Driver settlements →</h3><p class="muted">Trips, fuel advances, tolls and deductions into one net-pay figure per driver, checked against what your customer was billed.</p></a>
            <a class="card card-link" href="/solutions/marketplace-payout-reconciliation"><h3>Marketplace payouts →</h3><p class="muted">Match every order to the marketplace settlement and fee reports; find unpaid and short-paid orders.</p></a>
            <a class="card card-link" href="/solutions/excel-reconciliation-software"><h3>Any multi-file reconciliation →</h3><p class="muted">Supplier statements, branch stock reports, distributor claims — define the fields and rules once.</p></a>
        </div>
    </section>

    <section class="section grid grid-2" style="align-items:center">
        <div>
            <h2>Every number traces back to a row</h2>
            <p class="muted">Matching and arithmetic follow fixed, tested rules — never an AI guess — so the same files always produce the same settlement. Each figure links back to the file and row it came from, and every review decision is logged with who made it and when.</p>
            <p><a href="/security">How we protect your files →</a></p>
        </div>
        <ul class="checks">
            <li>IDs normalised: <code>T-1001</code> = <code>t1001</code> = <code>T 1001</code></li>
            <li>Dates in any format, Excel serial numbers, ₹/$ text amounts</li>
            <li>Duplicate and one-to-many matching (two fuel fills on one trip)</li>
            <li>Amount cross-checks with your own tolerance</li>
            <li>Macro-free, formula-injection-safe Excel output</li>
        </ul>
    </section>

    <section class="section">
        <div class="section-head"><h2 class="section-title">Simple monthly pricing</h2><a href="/pricing">Compare plans →</a></div>
        <partial name="_PlanCards" />
    </section>

    <section class="section faq">
        <h2 class="section-title">Frequently asked questions</h2>
        @foreach (var (q, a) in IndexModel.Faq)
        {
            <details><summary>@q</summary><p>@a</p></details>
        }
    </section>

    <partial name="_Cta" model="@((string?)null)" />
}
else
{
    var limits = Plans.For(Model.Org!.Plan);
    <div class="page-head">
        <div><h1>@Model.Org.Name</h1><div class="muted">@limits.Name plan</div></div>
        <a class="btn" asp-page="/Workflows/Index">New workflow</a>
    </div>
    @if (!(Model.HasRuns && Model.HasReviewed && Model.HasDownloaded))
    {
        var steps = new (bool Done, string Title, string Text, string? Page, object? Route)[]
        {
            (Model.Workflows.Count > 0, "Create a workflow", "Start from the driver-settlement template.", "/Workflows/Index", null),
            (Model.HasRuns, "Run your first reconciliation", "Upload your files — or try the demo week.", Model.Workflows.Count > 0 ? "/Runs/New" : null, Model.Workflows.Count > 0 ? new { workflowId = Model.Workflows[0].Id } : null),
            (Model.HasReviewed, "Review exceptions", "Accept or resolve what Reconza flagged.", Model.RecentRuns.Count > 0 ? "/Runs/Details" : null, Model.RecentRuns.Count > 0 ? new { id = Model.RecentRuns[0].Id } : null),
            (Model.HasDownloaded, "Download the settlement", "Excel workbook plus per-driver statements.", Model.RecentRuns.Count > 0 ? "/Runs/Details" : null, Model.RecentRuns.Count > 0 ? new { id = Model.RecentRuns[0].Id } : null),
        };
        var next = Array.FindIndex(steps, s => !s.Done);
        <section class="card onboarding">
            <div class="card-head"><div><h2 style="margin:0">Get your first settlement out</h2><div class="muted small">@steps.Count(s => s.Done) of @steps.Length done</div></div>
                <div class="progress" style="width:180px"><div class="progress-bar" style="width:@(steps.Count(s => s.Done) * 25)%"></div></div></div>
            <ol class="checklist">
                @for (var i = 0; i < steps.Length; i++)
                {
                    var st = steps[i];
                    <li class="@(st.Done ? "done" : i == next ? "next" : "")">
                        <span class="check-dot">@(st.Done ? "✓" : (i + 1).ToString())</span>
                        <div><strong>@st.Title</strong><div class="muted small">@st.Text</div></div>
                        @if (!st.Done && i == next && st.Page is not null) { <a class="btn btn-sm" href="@Url.Page(st.Page, st.Route)">Start</a> }
                    </li>
                }
            </ol>
        </section>
    }
    <div class="grid grid-4" style="margin-bottom:20px">
        <div class="stat"><div class="stat-label">Workflows</div><div class="stat-value">@Model.Workflows.Count</div><div class="stat-sub">of @limits.Workflows on your plan</div></div>
        <div class="stat"><div class="stat-label">Runs this month</div><div class="stat-value">@Model.RunsThisMonth</div><div class="stat-sub">@(limits.MonthlyRuns is { } mr ? $"of {mr} included" : "unlimited")</div></div>
        <div class="stat"><div class="stat-label">Rows processed</div><div class="stat-value">@Model.RowsThisMonth.ToString("N0")</div><div class="stat-sub">of @limits.MonthlyRows.ToString("N0") this month</div></div>
        <div class="stat"><div class="stat-label">Open exceptions</div><div class="stat-value @(Model.OpenExceptions > 0 ? "neg" : "")">@Model.OpenExceptions</div><div class="stat-sub">across all runs</div></div>
    </div>
    <div class="grid grid-2">
        <div class="card card-tight">
            <div class="card-head"><h2 style="margin:0">Workflows</h2></div>
            @if (Model.Workflows.Count == 0)
            {
                <div class="empty">No workflows yet. <a asp-page="/Workflows/Index">Create one from a template</a>.</div>
            }
            else
            {
                <table>
                    <tbody>
                    @foreach (var w in Model.Workflows)
                    {
                        <tr>
                            <td><a asp-page="/Workflows/Edit" asp-route-id="@w.Id">@w.Name</a></td>
                            <td class="right"><a class="btn btn-sm" asp-page="/Runs/New" asp-route-workflowId="@w.Id">Run</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
        <div class="card card-tight">
            <div class="card-head"><h2 style="margin:0">Recent runs</h2><a class="small" asp-page="/Runs/Index">All runs →</a></div>
            <partial name="_RunTable" model="Model.RecentRuns" />
        </div>
    </div>
}
