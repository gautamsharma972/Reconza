@model SettleFlow.Web.Data.Run
<div class="table-wrap">
<table class="responsive-table uploaded-files-table">
    <thead><tr><th>Used as</th><th>File</th><th class="num">Rows</th><th class="num">Size</th><th>Security check</th></tr></thead>
    <tbody>
    @foreach (var f in Model.Files.OrderBy(f => f.SourceName))
    {
        <tr>
            <td data-label="Used as">@f.SourceName</td>
            <td data-label="File">
                @if (f.StorageKey is not null) { <a asp-page="/Runs/Details" asp-page-handler="File" asp-route-id="@Model.Id" asp-route-fileId="@f.Id">@f.FileName</a> } else { @f.FileName }
                <details class="file-technical"><summary>File fingerprint</summary><code title="SHA-256">@f.Sha256</code></details>
            </td>
            <td data-label="Rows" class="num">@(f.Rows > 0 ? f.Rows.ToString("N0") : "—")</td>
            <td data-label="Size" class="num">@((f.SizeBytes / 1024.0).ToString("N1")) KB</td>
            <td data-label="Security check">@if (f.ScanStatus == "Clean") { <span class="badge badge-ok" title="@f.ScanDetail">✓ Scanned</span> } else { <span class="badge" title="@f.ScanDetail">Not scanned</span> }</td>
        </tr>
    }
    </tbody>
</table>
</div>
