@section Head {
    @JsonLd.Script(JsonLd.Article(AppUrls, page))
    @JsonLd.Script(JsonLd.Breadcrumbs(AppUrls, ("Home", "/"), ("Guides", "/guides"), (page.Title, page.Path)))
