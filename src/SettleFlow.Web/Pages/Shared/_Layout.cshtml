<!DOCTYPE html>
<html lang="en-IN">
@inject AppUrls Urls
@inject AppOptions AppConfig
@inject CompanyOptions Company
@inject SeoOptions SeoConfig
@{
    var path = Context.Request.Path.Value ?? "/";
    var seo = Seo.For(path);
    var indexable = seo is not null && User.Identity?.IsAuthenticated != true || ViewData["Indexable"] is true;
    var title = seo?.Title ?? ViewData["Title"] as string;
    var fullTitle = title is null ? "Reconza — reconciliation for operations teams"
        : title.StartsWith("Reconza") ? title : $"{title} | Reconza";
    var description = ViewData["Description"] as string ?? seo?.Description ?? Seo.DefaultDescription;
    var canonical = Urls.Absolute(seo?.Path ?? path);
    var ogImage = Urls.Absolute("/img/og.png");
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    @if (indexable)
    {
        <link rel="canonical" href="@canonical" />
        <meta name="robots" content="index,follow,max-image-preview:large" />
    }
    else
    {
        <meta name="robots" content="noindex,nofollow" />
    }
    <meta property="og:site_name" content="Reconza" />
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    <meta property="og:title" content="@(title ?? "Reconza")" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(title ?? "Reconza")" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />
    <meta name="theme-color" content="#1f5eff" />
    <meta name="application-name" content="Reconza" />
    @if (!string.IsNullOrEmpty(SeoConfig.GoogleVerification)) { <meta name="google-site-verification" content="@SeoConfig.GoogleVerification" /> }
    @if (!string.IsNullOrEmpty(SeoConfig.BingVerification)) { <meta name="msvalidate.01" content="@SeoConfig.BingVerification" /> }
    <link rel="icon" href="~/img/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<header class="topbar no-print">
    <div class="wrap topbar-inner">
        <a class="brand" asp-page="/Index"><span class="brand-mark">⇄</span> Reconza</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" data-nav-toggle>☰</button>
            string Active(string p) => path.StartsWith(p, StringComparison.OrdinalIgnoreCase) ? "active" : "";
            <nav class="nav">
                <a class="@(path == "/" ? "active" : "")" asp-page="/Index">Dashboard</a>
                <a class="@Active("/Workflows")" asp-page="/Workflows/Index">Workflows</a>
                <a class="@Active("/Runs")" asp-page="/Runs/Index">Runs</a>
                <a class="@Active("/Audit")" asp-page="/Audit/Index">Audit log</a>
                <a class="@Active("/Billing")" asp-page="/Billing/Index">Billing</a>
                <a class="@Active("/Settings")" asp-page="/Settings/Index">Settings</a>
            </nav>
            <form method="post" asp-page="/Account/Logout" class="userbox">
                <span class="muted">@User.Identity!.Name</span>
                <button class="btn-link" type="submit">Sign out</button>
            </form>
        }
        else
        {
            <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" data-nav-toggle>☰</button>
            <nav class="nav site-nav" aria-label="Main">
                <a href="/solutions/driver-settlement-software">Driver settlement</a>
                <a href="/solutions/marketplace-payout-reconciliation">Marketplaces</a>
                <a href="/tools/compare-excel-files">Free tool</a>
                <a href="/guides">Guides</a>
                <a href="/pricing">Pricing</a>
            </nav>
            <nav class="nav nav-right userbox">
                <a asp-page="/Account/Login">Sign in</a>
                <a class="btn btn-sm" asp-page="/Account/Register">Start free trial</a>
            </nav>
        }
    </div>
</header>
<main class="wrap main">
    @if (TempData["Flash"] is string flash)
    {
        <div class="toast" role="status" data-toast>@flash <button type="button" aria-label="Dismiss" data-toast-close>×</button></div>
    }
    @RenderBody()
</main>
<footer class="site-footer no-print">
    <div class="wrap footer-grid">
        <div>
            <a class="brand" href="/"><span class="brand-mark">⇄</span> Reconza</a>
            <p class="muted small" style="margin-top:10px">Reconciliation and settlement software for transporters, distributors and online sellers.</p>
        </div>
        <div><h4>Solutions</h4>
            <a href="/solutions/driver-settlement-software">Driver settlement software</a>
            <a href="/solutions/marketplace-payout-reconciliation">Marketplace payout reconciliation</a>
            <a href="/solutions/excel-reconciliation-software">Excel reconciliation software</a></div>
        <div><h4>Free resources</h4>
            <a href="/tools/compare-excel-files">Compare two Excel files</a>
            <a href="/guides/driver-settlement-excel-template">Driver settlement Excel template</a>
            <a href="/guides/weekly-driver-settlement-excel">Driver settlement in Excel</a>
            <a href="/guides/fuel-card-reconciliation">Fuel card reconciliation</a>
            <a href="/guides/marketplace-settlement-reconciliation">Marketplace settlement guide</a></div>
        <div><h4>Company</h4>
            <a href="/pricing">Pricing</a>
            <a href="/security">Security</a>
            <a href="/contact">Contact</a>
            <a href="/Account/Login">Sign in</a>
            @if (!string.IsNullOrEmpty(AppConfig.SupportEmail)) { <a href="mailto:@AppConfig.SupportEmail">@AppConfig.SupportEmail</a> }</div>
    </div>
    <div class="wrap muted small footer-bottom">© @DateTime.UtcNow.Year @(string.IsNullOrEmpty(Company.LegalName) ? "Reconza" : Company.LegalName) · <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> · <a href="/refund-policy">Refunds &amp; cancellation</a></div>
</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (indexable && !string.IsNullOrEmpty(SeoConfig.CloudflareAnalyticsToken))
{
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "@SeoConfig.CloudflareAnalyticsToken"}'></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
