@page "/contact"
@inject CompanyOptions Company
@section Head {
    @JsonLd.Script(JsonLd.Breadcrumbs(AppUrls, ("Home", "/"), ("Contact", "/contact")))
    @JsonLd.Script(new Dictionary<string, object> { ["@context"] = "https://schema.org", ["@type"] = "Organization", ["name"] = "Reconza", ["legalName"] = Company.LegalName, ["email"] = Company.Email, ["url"] = AppUrls.Absolute("/"), ["address"] = Company.Address })
}
<section class="page-hero">
    <h1>Contact us</h1>
    <p>Tell us what you need help with. We usually reply within one working day.</p>
</section>
<div class="grid grid-3 contact-grid">
    <a class="card card-link contact-card" href="mailto:@Company.Email?subject=Reconza%20demo"><span class="contact-icon" aria-hidden="true">▷</span><h2>See it on your files</h2><p>Tell us what reports you check and we will help you decide whether Reconza fits.</p><strong>Request a demo →</strong></a>
    <a class="card card-link contact-card" href="mailto:@Company.Email?subject=Reconza%20support"><span class="contact-icon" aria-hidden="true">?</span><h2>Account support</h2><p>Write from your account email so we can find your organisation quickly.</p><strong>Get help →</strong></a>
    <a class="card card-link contact-card" href="mailto:@Company.Email?subject=Reconza%20security"><span class="contact-icon" aria-hidden="true">◇</span><h2>Security or privacy</h2><p>Ask about file handling, retention, access controls or a data request.</p><strong>Ask a question →</strong></a>
</div>
<div class="card company-contact">
    <div><h2>Company details</h2><p><strong>@Company.LegalName</strong><br />@Company.Address</p>@if (!string.IsNullOrEmpty(Company.Gstin)) { <p class="muted small">GSTIN: @Company.Gstin</p> }</div>
    <div><h2>Email</h2><p><a class="contact-email" href="mailto:@Company.Email">@Company.Email</a></p>@if (!string.IsNullOrEmpty(Company.Phone)) { <p>@Company.Phone</p> }<p class="muted small">Please do not email passwords or full data files.</p></div>
    <p class="small company-links"><a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> · <a href="/refund-policy">Refunds &amp; cancellation</a> · <a href="/security">Security</a></p>
</div>
<partial name="_Cta" model="@("Want to see it on your own files?")" />
