@page "{id:guid}"
@model SettleFlow.Web.Pages.Runs.StatementModel
@{
    var tpl = Model.Def.Report;
    ViewData["Title"] = $"{tpl.GroupLabel} {Model.Line.Group} — {Model.Run.Label}";
}
<div class="page-head no-print">
    <div>
        <div class="crumbs"><a asp-page="Index">Runs</a> / <a asp-page="Details" asp-route-id="@Model.Run.Id">@Model.Run.Label</a></div>
        <h1>@tpl.GroupLabel statement</h1>
    </div>
    <div class="row">
        @if (Model.PrevGroup is not null) { <a class="btn btn-secondary" asp-route-id="@Model.Run.Id" asp-route-group="@Model.PrevGroup">‹ @Model.PrevGroup</a> }
        @if (Model.NextGroup is not null) { <a class="btn btn-secondary" asp-route-id="@Model.Run.Id" asp-route-group="@Model.NextGroup">@Model.NextGroup ›</a> }
        <button class="btn" type="button" data-print>Print / save PDF</button>
    </div>
</div>

<article class="statement card">
    <header class="statement-head">
        <div>
            <div class="muted small">@Model.OrgName</div>
            <h2 style="margin:2px 0 0; font-size:22px">@tpl.Title</h2>
            <div class="muted small">@Model.Run.Label @if (Model.Period.From is not null) { <span>· @Model.Period.From to @Model.Period.To</span> }</div>
        </div>
        <div class="statement-who">
            <div class="muted small">@tpl.GroupLabel</div>
            <div class="statement-id">@Model.Line.Group</div>
            @if (Model.DisplayName is not null) { <div>@Model.DisplayName</div> }
        </div>
    </header>

    <div class="statement-totals">
        @foreach (var s in Model.Def.Sources.Where(s => s.AmountField is not null && s.Role != SourceRole.ReferenceOnly))
        {
            var neg = s.Role == SourceRole.Deduction;
            <div><span class="muted small">@tpl.SourceLabels.GetValueOrDefault(s.Name, s.Name)</span>
                <strong class="@(neg ? "neg" : "")">@(neg ? "−" : "")@Model.Line.SourceTotals.GetValueOrDefault(s.Name).ToString("N2")</strong></div>
        }
        <div class="statement-net"><span class="small">@tpl.NetLabel</span><strong>@Model.Line.Net.ToString("N2")</strong></div>
    </div>

    @if (!Model.DetailsAvailable)
    {
        <div class="alert alert-info">Line items aren't available — this run's files were deleted under your retention policy, or it ran before itemized statements existed. Totals above are final.</div>
    }
    @foreach (var (source, cols, rows) in Model.Sections)
    {
        var counted = rows.Where(r => r.Included).ToList();
        <section class="statement-section">
            <h3>@tpl.SourceLabels.GetValueOrDefault(source.Name, source.Name) <span class="muted small">@source.Name · @counted.Count item@(counted.Count == 1 ? "" : "s")</span></h3>
            <table>
                <thead><tr>@foreach (var c in cols) { <th>@c.Label</th> }@if (source.AmountField is not null) { <th class="num">Amount</th> }<th class="muted">Row</th></tr></thead>
                <tbody>
                @foreach (var row in rows)
                {
                    <tr class="@(row.Included ? "" : "is-excluded")">
                        @foreach (var c in cols) { <td>@row.Values.GetValueOrDefault(c.Name)</td> }
                        @if (source.AmountField is not null) { <td class="num">@(row.Amount?.ToString("N2"))</td> }
                        <td class="muted small">@row.Row @if (!row.Included) { <span class="badge">not counted</span> }</td>
                    </tr>
                }
                </tbody>
                @if (source.AmountField is not null && source.Role != SourceRole.ReferenceOnly)
                {
                    <tfoot><tr><td colspan="@cols.Count">Subtotal</td><td class="num">@counted.Sum(r => r.Amount ?? 0).ToString("N2")</td><td></td></tr></tfoot>
                }
            </table>
        </section>
    }

    @if (Model.Exceptions.Count > 0)
    {
        <section class="statement-section">
            <h3>Notes &amp; queries</h3>
            <ul class="statement-notes">
                @foreach (var e in Model.Exceptions)
                {
                    <li><span class="badge badge-@ExceptionHelp.For(e.Type).Tone">@ExceptionHelp.For(e.Type).Title</span> @e.Message
                        @if (e.Status != ExceptionStatus.Open) { <span class="muted">— @e.Status.ToString().ToLower()@(e.Note is null ? "" : $": {e.Note}")</span> }</li>
                }
            </ul>
        </section>
    }
    <footer class="muted small statement-foot">Generated by Reconza from source files with SHA-256 fingerprints recorded in the audit log. Row numbers refer to the uploaded spreadsheets.</footer>
</article>
