@page
@model SettleFlow.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Forgot password"; }
<div class="form-narrow card">
    <h1>Reset your password</h1>
    @if (Model.Sent)
    {
        <div class="alert alert-ok">If an account exists for that address, we've emailed a reset link. It expires in 3 hours.</div>
        <a asp-page="Login">Back to sign in</a>
    }
    else
    {
        <p class="muted">Enter your work email and we'll send you a link to choose a new password.</p>
        <form method="post" data-busy-form>
            <div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="username" required /></div>
            <button class="btn" type="submit" data-busy="Sending…">Send reset link</button>
            <a class="small" asp-page="Login" style="margin-left:10px">Back to sign in</a>
        </form>
    }
</div>
